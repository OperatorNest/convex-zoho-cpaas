# Copy to .env.e2e (gitignored) for maintainer-led end-to-end testing against Zoho CPaaS.
# `pnpm e2e --dry-run` checks input names without network calls; `pnpm e2e` loads
# only ZOHO_CPAAS_* deployment settings into the existing anonymous local Convex deployment.
# `pnpm e2e:env` loads those deployment settings independently; values are never printed.

# Data center of your account: us | eu | in | au | jp | cn
ZOHO_CPAAS_REGION=eu
# Mail Agent → SMTP/API → Send Mail Token (the value after "Zoho-enczapikey ").
ZOHO_CPAAS_TOKEN=
# Optional account-specific API host override; leave empty for the region default.
ZOHO_CPAAS_BASE_URL=
# Optional Mail Agent token override; leave empty to use the shared token.
ZOHO_CPAAS_EMAIL_TOKEN=
# Optional SMS token override; leave empty to use the shared token.
ZOHO_CPAAS_SMS_TOKEN=
# Optional WhatsApp token override; leave empty to use the shared token.
ZOHO_CPAAS_WHATSAPP_TOKEN=
# Webhooks → the secret key you enter for the tunnel URL webhook.
ZOHO_CPAAS_WEBHOOK_SECRET=
# Optional previous webhook key during rotation.
ZOHO_CPAAS_WEBHOOK_SECRET_PREVIOUS=
# Optional terminal-record retention in days (1–3650).
ZOHO_CPAAS_RETENTION_DAYS=

# Address on a domain verified in this Zoho Mail Agent.
E2E_EMAIL_FROM=
# Inbox controlled by the maintainer; open the tracked message and click its link.
E2E_EMAIL_TO=
# Optional second address alias controlled by the maintainer for a two-recipient batch.
E2E_EMAIL_BATCH_ALIAS=
# Optional existing Zoho email template key for email.sendTemplate.
E2E_EMAIL_TEMPLATE_KEY=
# Optional JSON object of string variables required by that email template.
E2E_EMAIL_TEMPLATE_MERGE_INFO=
# Optional guaranteed-invalid address on the maintainer's verified domain for a hard-bounce probe.
E2E_BOUNCE_TO=
# Optional approved WhatsApp sender number registered in this Agent.
E2E_WHATSAPP_FROM=
# Optional WhatsApp recipient number controlled by the maintainer.
E2E_WHATSAPP_TO=
# Optional approved WhatsApp template key; all three WhatsApp inputs enable its send.
E2E_WHATSAPP_TEMPLATE=
# Optional JSON object of string variables required by the WhatsApp template.
E2E_WHATSAPP_MERGE_INFO=
# India DC only: optional approved DLT SMS sender key.
E2E_SMS_SENDER_KEY=
# India DC only: optional SMS recipient number controlled by the maintainer.
E2E_SMS_TO=
# India DC only: optional approved SMS template key (the legacy input name).
E2E_SMS_TEMPLATE=
# India DC only: optional JSON object of string variables required by the SMS template.
E2E_SMS_MERGE_INFO=
